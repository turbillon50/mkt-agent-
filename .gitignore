services/baileys/sessions-goossip/

# Capturas de QA: viven en el servidor, no en el repo (15 MB de PNG).
# El resumen medido sí se versiona.
capturas-c3/*
!capturas-c3/resumen.json
capturas-c4/*
!capturas-c4/resumen.json
!capturas-c4/barrido-clerk.json

# Igual para las de la corrida 5 (8 MB de PNG).
capturas-c5/*
!capturas-c5/resumen.json

# Igual para las de la corrida 6.
capturas-c6/*
!capturas-c6/resumen.json

# Igual para las de la corrida 7 (21 MB de PNG). Lo que se versiona es la
# MEDICIÓN: cuántas pantallas, con qué código y qué contó la máquina.
capturas-c7/*
!capturas-c7/resumen.json

# Igual para las de la corrida 8. El resumen y la aceptación sí se versionan:
# son la medición, no la foto.
capturas-c8/*
!capturas-c8/resumen.json
!capturas-c8/aceptacion.json

# Y las de la INTEGRACIÓN de la 7 con la 8: la prueba de que conviven en la
# misma pantalla. Mismo trato — se versiona la medición, no los 2.3 MB de PNG.
capturas-integracion-c8/*
!capturas-integracion-c8/resumen.json

# Igual para las de la corrida 11. Lo que se versiona es la MEDICIÓN.
capturas-c11/*
!capturas-c11/resumen.json

# Corrida 12: se versiona la MEDICIÓN del recorrido, no los PNG pesados.
capturas-c12/*
!capturas-c12/resumen.json
