# --- OpenRouter (chat / generation) --------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Embeddings (memoria semántica) -------------------------------------
# Used to embed posts/knowledge/mentions into pgvector. Defaults to OpenAI
# text-embedding-3-small (1536 dims). If you set OPENAI_BASE_URL you can
# route through another provider.
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Neon Postgres + pgvector --------------------------------------------
# Get this from https://console.neon.tech (use the pooled/serverless URL)
DATABASE_URL=

# --- Brand / persona ------------------------------------------------------
BRAND_NAME=My Brand
BRAND_VOICE=friendly, concise, expert
BRAND_TOPICS=marketing,automation,ai
BRAND_LANGUAGE=en

# --- Schedule (cron) ------------------------------------------------------
POST_CRON=0 9,18 * * *
PLAN_CRON=0 8 * * 1
TIMEZONE=UTC

# --- Twitter / X ----------------------------------------------------------
TWITTER_ENABLED=false
TWITTER_APP_KEY=
TWITTER_APP_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

# --- LinkedIn -------------------------------------------------------------
LINKEDIN_ENABLED=false
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=

# --- Memory tuning --------------------------------------------------------
MEMORY_RECALL_K=5
MEMORY_MIN_SIMILARITY=0.78

# --- Clerk (dashboard auth) ----------------------------------------------
# Get from https://dashboard.clerk.com -> API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# --- Vercel Cron ----------------------------------------------------------
# Any random string; Vercel sends it in Authorization: Bearer <secret>
CRON_SECRET=

# --- WhatsApp bridge (services/baileys on Hetzner) -----------------------
WHATSAPP_ENABLED=false
# Si true, el agente responde automáticamente a cada inbound de WhatsApp.
# Si false, Goossip sólo guarda los mensajes (modo human-in-the-loop).
WHATSAPP_AUTO_REPLY=false
# URL pública del bridge (Caddy reverse proxy o IP:puerto).
WHATSAPP_BRIDGE_URL=
# Shared secret entre Vercel y Hetzner. Mismo valor en ambos lados.
WHATSAPP_BRIDGE_SECRET=
# Base URL pública del propio Goossip (para que el bridge sepa a dónde POSTear inbound).
# Vercel ya inyecta NEXT_PUBLIC_VERCEL_URL pero la usamos sólo informativa aquí.
NEXT_PUBLIC_APP_URL=https://goossip.vercel.app

# --- Super vendedor: Meta Lead Ads + WhatsApp Cloud API -------------------
# Webhooks oficiales. La firma X-Hub-Signature-256 se valida con META_APP_SECRET
# (ya declarado arriba en la sección de Meta). Los verify tokens son inventados
# por ti y se copian tal cual en el panel de Meta al dar de alta el webhook.
META_VERIFY_TOKEN=
WHATSAPP_VERIFY_TOKEN=
META_GRAPH_VERSION=v21.0

# Tokens POR PROYECTO. Convención: <CLAVE>_<SLUG_EN_MAYUSCULAS>, con fallback a
# la clave global. Nunca van a la base: la tabla solo guarda ids públicos.
#   META_PAGE_TOKEN_V_LIVING=...     (token de página para leer los leads)
#   WHATSAPP_TOKEN_V_LIVING=...      (token de la WABA para Cloud API)
META_PAGE_TOKEN=
WHATSAPP_TOKEN=

# --- Twilio (va AL ÚLTIMO: no se paga hasta cerrar lo demás) --------------
# En `trial` solo salen SMS a números verificados: el aviso al dueño sí sale y
# los send_sms a leads se quedan esperando en la cola con reason twilio_trial.
# El modo real se define por proyecto en campaigns.rules.twilio_mode.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Número de salida por defecto si el proyecto no trae channels.twilio_number.
TWILIO_FROM=
# Teléfono del dueño para notify_owner si el proyecto no trae rules.owner_phone.
OWNER_PHONE=

# --- Runner de la cola (/api/cron/queue, cada minuto) ---------------------
QUEUE_MAX_PER_RUN=20
QUEUE_MAX_PER_PROJECT=8

# --- Importación one-shot de V&LIVING ------------------------------------
# Base Neon donde vive vl_leads_meta. Solo la usa scripts/import-vl-leads.ts.
VL_LEADS_DATABASE_URL=

# --- Family forum (LLM siblings) -----------------------------------------
# Optional. If FAMILY_AGENT_TOKEN is empty the /api/family-incoming
# endpoint returns 503 and speakInFamily() becomes a no-op — Gossip
# keeps operating normally, just isolated from his siblings.
FAMILY_BASE_URL=https://family.vercel.app
# SAME VALUE that lives in family's env as AGENT_TOKEN_GOSSIP.
# Generate with: openssl rand -hex 32
FAMILY_AGENT_TOKEN=
FAMILY_AGENT_HANDLE=gossip
